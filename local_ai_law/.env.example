# RAG Studio — Environment Configuration
# Copy to .env and edit as needed. All values have sensible defaults.

# Server
# RAG_HOST=0.0.0.0
# RAG_PORT=8000
# RAG_WORKERS=1

# Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# RAG_MAX_OLLAMA_NUM_CTX=8192
# RAG_OLLAMA_KEEP_ALIVE=30s
# RAG_OLLAMA_TIMEOUT=180
# RAG_OLLAMA_CHAT_CONCURRENCY=1
# RAG_EMBED_BATCH_SIZE=32

# Worker pools (safe defaults for one local GPU)
# RAG_CRITICAL_WORKERS=1
# RAG_LOW_WORKERS=1

# Expensive module automation (manual/conservative by default)
# RAG_AUTO_STUDY_PIPELINE=false
# RAG_AUTO_WIKI_BUILD=false
# RAG_AUTO_GRAPH_BUILD=false
# RAG_AUTO_CONTRADICTIONS=false

# Paths (absolute paths recommended)
# RAG_MAIN_STUDY=/path/to/your/study/folder
# RAG_DATA_DIR=./data

# HTTPS (set to true to enable uvicorn TLS for non-Docker local dev)
# RAG_HTTPS_ENABLED=false
# RAG_CERT_FILE=./certs/cert.pem
# RAG_KEY_FILE=./certs/key.pem

# Limits
# RAG_MAX_UPLOAD_MB=50
# RAG_MAX_QUERY_CHARS=4000
# RAG_RATE_LIMIT=30

# Backup
# RAG_BACKUP_INTERVAL_HOURS=24
# RAG_BACKUP_KEEP_COUNT=7

# Branding (customise per deployment)
# RAG_APP_NAME=RAG Studio
# RAG_TAGLINE=Local-first RAG knowledge base & study assistant
# RAG_LOGO_URL=
# RAG_PRIMARY_COLOR=#6366f1
# RAG_FAVICON_URL=

# Auth
# RAG_JWT_SECRET=

# Logging
# RAG_LOG_LEVEL=INFO
